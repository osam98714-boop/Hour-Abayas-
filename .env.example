# Primary Neon PostgreSQL connection string; never commit real credentials.
NEON_DATABASE_URL=your-neon-connection-string-here
# Vercel's Neon integration may provide DATABASE_URL instead.
# DATABASE_URL=your-neon-connection-string-here

# Separate Vercel Blob stores: public Products and private Reviews.
# Configure the stores with PRODUCT_BLOB and REVIEW_BLOB environment prefixes.
PRODUCT_BLOB_READ_WRITE_TOKEN=replace-with-public-products-store-token
REVIEW_BLOB_READ_WRITE_TOKEN=replace-with-private-reviews-store-token

# Admin sign-in values; set these in Vercel Project Settings > Environment Variables.
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=choose-a-strong-admin-password
# At least 32 characters; keep secret and do not commit a real value.
MANUS_JWT_SECRET=replace-with-a-long-random-secret

# Public browser key for Maps JavaScript API; restrict by HTTP referrer and API in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=restricted-google-maps-browser-key
