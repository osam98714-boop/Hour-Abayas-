# Neon PostgreSQL connection string; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require

# Separate Vercel Blob stores: public Products and private Reviews.
# Configure the stores with PRODUCT_BLOB and REVIEW_BLOB environment prefixes.
PRODUCT_BLOB_READ_WRITE_TOKEN=replace-with-public-products-store-token
REVIEW_BLOB_READ_WRITE_TOKEN=replace-with-private-reviews-store-token

# Manus OAuth values must be supplied/approved by the OAuth provider.
# Allow https://YOUR-VERCEL-DOMAIN/api/oauth/callback with the provider first.
MANUS_PROJECT_ID=replace-with-project-id
MANUS_OAUTH_PORTAL_URL=replace-with-approved-oauth-portal-url
MANUS_OAUTH_API_URL=replace-with-approved-oauth-api-url
MANUS_JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=replace-with-your-manus-open-id
