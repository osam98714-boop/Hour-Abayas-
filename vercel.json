{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__hour_abayas_original_api_path=/api/:path*"
    },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/women", "destination": "/index.html" },
    { "source": "/kids", "destination": "/index.html" },
    { "source": "/product/:id", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/404", "destination": "/index.html" }
  ]
}
